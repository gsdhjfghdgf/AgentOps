# Copy to .env and fill your own service credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/agent_memory?currentSchema=agent_memory
SPRING_DATASOURCE_USERNAME=agent
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=16380
SPRING_DATA_REDIS_PASSWORD=
MODEL_API_KEY=
# Streaming: first byte / idle / total request limits (seconds).
AGENT_MODEL_STREAM_TIMEOUTS_FIRST_BYTE_SECONDS=120
AGENT_MODEL_STREAM_TIMEOUTS_IDLE_SECONDS=90
AGENT_MODEL_STREAM_TIMEOUTS_MAX_DURATION_SECONDS=600
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_API_BASE=http://127.0.0.1:8080
# Desktop backend listens only on loopback by default. Add exact frontend origins for a separate web deployment.
AGENT_BIND_ADDRESS=127.0.0.1
# Optional: override the backend and desktop registration-key location together; never commit its contents.
# AGENT_REGISTRATION_KEY_FILE=C:/Users/your-user/.agentops/registration.key
# AGENT_WEB_ALLOWED_ORIGINS=null,http://localhost:5173,http://127.0.0.1:5173
# Optional HTTP CONNECT proxy for public pages/images; otherwise HTTPS_PROXY/HTTP_PROXY is used.
# PUBLIC_WEB_PROXY_URL=http://127.0.0.1:7890
