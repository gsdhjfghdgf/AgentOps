{
  "name": "agent-desktop",
  "productName": "AgentOps 智能助手",
  "version": "0.1.28",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER=http://localhost:5173 electron .\"",
    "prepare:electron": "node node_modules/electron/install.js",
    "dist": "npm run build && npm run prepare:electron && electron-builder --win nsis",
    "dist:dir": "npm run build && npm run prepare:electron && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "15.0.12",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "3.3.14"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.agentops.desktop",
    "productName": "AgentOps 智能助手",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentOps 智能助手",
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}
